{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],

    "rewrites": [
      {
        "source": "/api/**",
        "function": "app"
      }
    ],

    "redirects": [
      {
        "source": "**",
        "destination": "/404.html",
        "type": 404
      }
    ]
  }
}